# Backend Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database URI (Roll numbers, Student records, Attempts, Violations)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/proctor-db?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_random_key_min_32_characters
JWT_EXPIRES_IN=12h

# Airtable API (Admins, Tests, and MCQs ONLY)
AIRTABLE_API_KEY=pat_your_airtable_personal_access_token
AIRTABLE_BASE_ID=app_your_airtable_base_id
AIRTABLE_TABLE_ADMINS=Admins
AIRTABLE_TABLE_TESTS=Tests
AIRTABLE_TABLE_MCQS=MCQs

# Email OTP Configuration (Brevo API or SMTP)
BREVO_API_KEY=
MAIL_FROM=no-reply@smartproctor.edu

# Optional SMTP fallback (used if BREVO_API_KEY is not provided)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# CORS Allowed Origins (Comma-separated URLs for Student and Admin web apps)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# AI Proctoring & Security Thresholds
FACE_THRESHOLD=0.45
LOCK_MINUTES=5
MAX_STRIKES=3

# Development Convenience (Set to false in production)
DEV_SHOW_OTP=true
DEMO_ADMIN_EMAIL=admin@example.com
