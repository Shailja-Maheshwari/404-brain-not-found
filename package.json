{
  "name": "deviathon-smart-proctor",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "description": "Smart Proctoring Browser - Deviathon WUElev8",
  "scripts": {
    "start": "electron .",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "electron:exam": "electron . --exam",
    "build:electron": "electron-builder",
    "build:student": "npm run build --prefix proctor-ui",
    "build:admin": "npm run build --prefix proctor-admin",
    "build:all": "npm run build:student && npm run build:admin",
    "dev:backend": "npm run dev --prefix proctor-backend",
    "dev:student": "npm run dev --prefix proctor-ui",
    "dev:admin": "npm run dev --prefix proctor-admin"
  },
  "build": {
    "appId": "com.deviathon.smartproctor",
    "productName": "Smart Proctor",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "proctor-ui/dist/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  }
}
